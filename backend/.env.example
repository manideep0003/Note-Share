# Server Configuration
# Note: On macOS, Port 5000 is often reserved by AirPlay Receiver (Control Center). Port 5001 is recommended.
PORT=5001
NODE_ENV=development

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/noteshare?retryWrites=true&w=majority

# JWT Configuration (for Phase 2)
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=30d

# Cloudinary Configuration (for Phase 4)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Configuration (set to match your React/Vite/Next frontend URL)
FRONTEND_URL=http://localhost:3000
CLIENT_URL=http://localhost:3000
